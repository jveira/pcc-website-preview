{
  "trailingSlash": true,
  "redirects": [
    { "source": "/alpha-fc/", "destination": "/programs/alpha-fc/", "permanent": true },
    { "source": "/caminos-nativos/", "destination": "/programs/caminos-nativos/", "permanent": true },
    { "source": "/2022-year-in-review/", "destination": "/stories/2022-year-in-review/", "permanent": true },
    { "source": "/2023-year-in-review/", "destination": "/stories/2023-year-in-review/", "permanent": true },
    { "source": "/2024-year-in-review/", "destination": "/stories/2024-year-in-review/", "permanent": true },
    { "source": "/2025-year-in-review/", "destination": "/stories/2025-year-in-review/", "permanent": true },
    { "source": "/our-team/", "destination": "/about/", "permanent": true },
    { "source": "/our-values/", "destination": "/about/", "permanent": true },
    { "source": "/contact-us/", "destination": "/donate/", "permanent": true },
    { "source": "/faqs/", "destination": "/donate/", "permanent": true },
    { "source": "/homepage/", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
